[Unit]
Description=HISKA HX-KEG450 LCD live display
Documentation=https://github.com/securityvisions/hiska-keg450-lcd
After=graphical-session.target

[Service]
Type=simple
# Adjust the path, the provider and the interval to taste.
# Keep the interval at 30 s or more: each upload rewrites the screen image.
ExecStart=%h/Personal/hiska-keg450-lcd/live.py --provider sys --interval 60
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
